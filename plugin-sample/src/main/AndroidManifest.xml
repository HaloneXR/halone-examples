<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_plugin"
        android:label="Halone sample plugin">

        <service
            android:name=".SampleProvider"
            android:exported="true"
            android:label="Sample plugin"
            android:permission="dev.halone.permission.BIND_PANEL_PROVIDER">
            <intent-filter>
                <action android:name="dev.halone.action.PANEL_PROVIDER" />
            </intent-filter>
            <meta-data
                android:name="dev.halone.plugin.CONTRACT"
                android:value="1" />
        </service>
    </application>
</manifest>
